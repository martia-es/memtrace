{
  "description": "With MEMTRACE_CAPTURE_CONTENT=true the messages are recorded as JSON text.",
  "env": {
    "MEMTRACE_CAPTURE_CONTENT": "true"
  },
  "init": {
    "serviceName": "conf-agent"
  },
  "actions": [
    {
      "op": "step",
      "name": "answer",
      "type": "llm",
      "actions": [
        {
          "op": "llm",
          "provider": "anthropic",
          "model": "claude-x",
          "inputMessages": [
            {
              "role": "user",
              "content": "hello"
            }
          ],
          "outputMessages": [
            {
              "role": "assistant",
              "content": "hi"
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "spans": [
      {
        "name": "answer",
        "attributesJson": {
          "gen_ai.input.messages": [
            {
              "role": "user",
              "content": "hello"
            }
          ],
          "gen_ai.output.messages": [
            {
              "role": "assistant",
              "content": "hi"
            }
          ]
        }
      }
    ]
  }
}
