{
  "description": "Captured content is masked before export: values under secret-looking keys become **** (ADR-021, ADR-084).",
  "env": {
    "MEMTRACE_CAPTURE_CONTENT": "true"
  },
  "init": {
    "serviceName": "conf-agent"
  },
  "actions": [
    {
      "op": "step",
      "name": "answer",
      "type": "llm",
      "actions": [
        {
          "op": "llm",
          "provider": "anthropic",
          "model": "claude-x",
          "inputMessages": [
            {
              "role": "user",
              "content": "hello",
              "api_key": "sk-secret-value"
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "spans": [
      {
        "name": "answer",
        "attributesJson": {
          "gen_ai.input.messages": [
            {
              "role": "user",
              "content": "hello",
              "api_key": "****"
            }
          ]
        }
      }
    ]
  }
}
