# Asistente del tiempo. Copia a weather_assistant/.env (ignorado por git). La raíz .env sirve de respaldo (p. ej. GOOGLE_API_KEY).

# LLM (Gemini)
GOOGLE_API_KEY=""

# Trazas: API key del experimento de este asistente
WEATHER_ASSISTANT_MEMTRACE_HEADERS="authorization=Bearer mtk_..."
WEATHER_ASSISTANT_MEMTRACE_ENDPOINT="http://localhost:8080/api/v1/ingest"
MEMTRACE_CAPTURE_CONTENT=true

# Prompt del registro: la URL incluye el id del experimento
WEATHER_ASSISTANT_PROMPT="weather-system"
MEMTRACE_API_URL=""
MEMTRACE_API_KEY=""
# Tag que sigue el prompt: dev | pre | pro (por defecto dev)
MEMTRACE_ENVIRONMENT="dev"
