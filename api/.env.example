# Conexión al almacén (por defecto, el port-forward de `make up`)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=memtrace-dev-only
CLICKHOUSE_DATABASE=memtrace
# Protección del almacén: hilos por consulta y consultas simultáneas
CLICKHOUSE_QUERY_MAX_THREADS=2
CLICKHOUSE_MAX_CONCURRENT_QUERIES=3
