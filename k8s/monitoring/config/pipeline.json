      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cola del Collector (lotes)",
      "description": "Si la cola se acerca a la capacidad, ClickHouse escribe más despacio de lo que llegan los datos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(otelcol_exporter_queue_size)",
          "legendFormat": "en cola",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(otelcol_exporter_queue_capacity)",
          "legendFormat": "capacidad",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
