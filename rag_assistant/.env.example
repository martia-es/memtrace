# Asistente RAG de FAQs. Copia a rag_assistant/.env (ignorado por git). La raíz .env sirve de respaldo (p. ej. GOOGLE_API_KEY).

# LLM y embeddings (Gemini)
GOOGLE_API_KEY=""

# Trazas: API key del experimento de este asistente (Admin → experimento → API keys)
RAG_ASSISTANT_MEMTRACE_HEADERS="authorization=Bearer mtk_..."
RAG_ASSISTANT_MEMTRACE_ENDPOINT="http://localhost:8080/api/v1/ingest"
RAG_ASSISTANT_SERVICE_NAME=""
MEMTRACE_CAPTURE_CONTENT=true

# Prompt del registro: nombre y experimento donde vive (la URL incluye el id del experimento)
RAG_ASSISTANT_PROMPT="faq-system"
RAG_ASSISTANT_MEMTRACE_API_URL=""
RAG_ASSISTANT_MEMTRACE_API_KEY=""
# Tag que sigue el prompt: dev | pre | pro (por defecto dev)
MEMTRACE_ENVIRONMENT="dev"
